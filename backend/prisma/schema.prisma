generator client { provider = "prisma-client-js" }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN }

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MenuItem {
  id            String   @id @default(cuid())
  name          String
  size          String?
  price         Int?
  categoryId    String
  categoryName  String
  categoryOrder Int      @default(0)
  itemOrder     Int      @default(0)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([isAvailable, categoryOrder, itemOrder])
  @@index([categoryId])
}
